@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-4">

    <h1 class="fw-bold mb-2" style="color: #4a6fa5;">Contact Us</h1>
    <p class="text-muted mb-4">Have a question or want to adopt? Send us a message and we will get back to you.</p>

    <div class="card shadow-sm border-0" style="max-width: 600px;">
        <div class="card-body p-4">
            <form>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" class="form-control" placeholder="Enter your name" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" class="form-control" placeholder="Enter your email" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Message</label>
                    <textarea class="form-control" rows="5" placeholder="Write your message here..."></textarea>
                </div>

                <button type="submit" class="btn text-white w-100" style="background-color: #4a6fa5;">
                    Send Message
                </button>
            </form>
        </div>
    </div>

</div>
